# Copied to .env by cmd/ftp/run.sh on first run.
# These are passed to cmd/ftp as CLI flags by cmd/ftp/run.sh.

# Host the vsftpd container (started by scripts/start-ftp.sh) listens on.
FTP_HOST=127.0.0.1
# Control port. With --network host the container binds 21 directly.
FTP_PORT=21
FTP_USER=test
FTP_PASS=test
FTP_TIMEOUT=15000

# Default subcommand + args passed to cmd/ftp when run.sh is invoked with no
# arguments. Override by passing your own args, e.g. `./run.sh put ./x /x`.
FTP_COMMAND="ls /"
