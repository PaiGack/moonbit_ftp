# Copied to .env by cmd/example/run.sh on first run.
# These are read directly by cmd/example via the env API.

# Host the vsftpd container (started by scripts/start-ftp.sh) listens on.
FTP_TEST_HOST=127.0.0.1
# Control port. With --network host the container binds 21 directly.
FTP_TEST_PORT=21
FTP_TEST_USER=test
FTP_TEST_PASS=test
